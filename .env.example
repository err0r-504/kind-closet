# База данных PostgreSQL
POSTGRES_DB=kind_closet_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# S3
AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=kind-closet-images

# JWT Секреты
JWT_SECRET=SuperSecretKeyForKindClosetApp2026Minimum32CharsLength!
JWT_ISSUER=kind-closet-api
JWT_AUDIENCE=kind-closet-client